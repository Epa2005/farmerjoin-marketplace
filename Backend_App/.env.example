# Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=24h
SESSION_SECRET=your_super_secure_session_secret_here_change_this_in_production

# Database Configuration
DB_CLIENT=postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_url_encoded_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=false
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=farmerjoin_marketplace
DB_PORT=5432

# Supabase Storage (for profile photos & product images so they persist
# across Render redeploys). Get these from Supabase Dashboard ->
# Project Settings -> API.
#   SUPABASE_URL            = https://<your-project-ref>.supabase.co
#   SUPABASE_SERVICE_KEY    = service_role key (keeps uploads working
#                             even with Storage RLS policies enabled)
#   SUPABASE_PUBLIC_BUCKET  = "uploads" (create it with
#                             scripts/setup_supabase_storage.sql)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_PUBLIC_BUCKET=uploads

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# File Upload Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:5000

# pawaPay Configuration (Mobile Money Payment)
PAWAPAY_API_URL=https://sandbox.pawapay.com
PAWAPAY_API_KEY=your_pawapay_api_key_here
PAWAPAY_MERCHANT_ID=your_pawapay_merchant_id_here

# Africa's Talking Configuration (SMS Service)
AFRICASTALKING_API_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_USERNAME=your_actual_username_here
AFRICASTALKING_API_KEY=your_actual_api_key_here
